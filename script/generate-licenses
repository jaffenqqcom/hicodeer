#!/usr/bin/env bash

set -euo pipefail

CARGO_ABOUT_VERSION="0.8.2"

# Everything is resolved against the repository root so the script behaves the
# same from CI, a developer checkout and a `bash script/...` call from elsewhere.
PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

OUTPUT_FILE="${1:-$PROJECT_ROOT/assets/licenses.md}"
TEMPLATE_FILE="script/licenses/template.md.hbs"
CONFIG_FILE="script/licenses/hicodeer-licenses.toml"
DAEMON_DIR="crates/gpui_ohos/depend/cmd-agent/hicodeerd"

# Runs a command and treats anything on stderr as failure, which is how
# cargo-about's "warning: unresolved" noise is turned into a hard error.
# STDERR_ALLOW_PATTERN filters out warnings that are already accounted for
# (the franken stack has no classifiable license text; its terms are emitted by
# the CUSTOM LICENSE TERMS section instead).
fail_on_stderr() {
    local tmpfile=$(mktemp)
    if [ -n "${STDERR_ALLOW_PATTERN-}" ]; then
        "$@" 2> >(grep -v -E "$STDERR_ALLOW_PATTERN" | tee "$tmpfile" >&2)
    else
        "$@" 2> >(tee "$tmpfile" >&2)
    fi
    local rc=$?
    [ -s "$tmpfile" ] && rc=1
    rm "$tmpfile"
    return $rc
}

if ! cargo about --version | grep "cargo-about $CARGO_ABOUT_VERSION" &>/dev/null; then
    echo "Installing cargo-about@$CARGO_ABOUT_VERSION..."
    cargo install "cargo-about@$CARGO_ABOUT_VERSION"
else
    echo "cargo-about@$CARGO_ABOUT_VERSION is already installed."
fi

echo -n "" >"$OUTPUT_FILE"

# ==================== Static sections ====================
# Every byte that ships but does not come from a cargo dependency lives here.
# The sections are generated from sources in the tree (never typed by hand) so
# adding a font or an extension without declaring its license fails the build
# instead of silently shipping it.
{
    echo -e "# ###### THEME LICENSES ######\n"
    cat assets/themes/LICENSES

    echo -e "\n# ###### ICON LICENSES ######\n"
    cat assets/icons/LICENSES

    echo -e "\n# ###### FONT LICENSES ######\n"
    for font_dir in assets/fonts/*/; do
        font_name="$(basename "$font_dir")"
        license_file=""
        for candidate in "$font_dir/license.txt" "$font_dir/OFL.txt" \
                         "$font_dir/LICENSE" "$font_dir/LICENSE.txt" "$font_dir/LICENSE.md"; do
            if [ -f "$candidate" ]; then
                license_file="$candidate"
                break
            fi
        done
        if [ -z "$license_file" ]; then
            echo "generate-licenses: ERROR: no license file under $font_dir" >&2
            exit 1
        fi
        printf '## [%s]\n\n' "$font_name"
        cat "$license_file"
        printf '\n%s\n\n' '********************************************************************************'
    done

    echo -e "\n# ###### EXTENSION LICENSES ######\n"
    # Generated by script/licenses/generate-extension-licenses.py from the
    # archive in assets/extensions plus assets/extensions/licenses.json.
    cat assets/extensions/LICENSES

    echo -e "\n# ###### BUNDLED ASSET LICENSES ######\n"
    # Files shipped inside the HAP that are neither code nor extensions
    # (CA bundle; the QEMU engine when that backend is enabled).
    cat assets/bundled/LICENSES

    echo -e "\n# ###### CUSTOM LICENSE TERMS ######\n"
    # Dependencies cargo-about cannot render: the franken stack declares a
    # custom expression (`LicenseRef-MIT-OpenAI-Anthropic-Rider`) and some of
    # its crates carry the text only via `license-file`, so cargo-about drops
    # the whole group with "has no license file". Generated from `cargo
    # metadata` so a new dependency with the same terms is picked up.
    python3 script/licenses/generate-rider-licenses.py

    echo -e "\n# ###### CODE LICENSES ######\n"
} >>"$OUTPUT_FILE"

# ==================== Code licenses ====================
# Two independent dependency graphs ship inside libcore.so / hicodeerd.hnp and
# `cargo about` only sees one lock file at a time:
#
#   * the top-level workspace (editor, gpui_ohos, openharmony-ability, ...),
#   * crates/gpui_ohos/depend/cmd-agent/hicodeerd (the daemon). It pulls
#     herdr/ in as a path dependency, so this single run also covers herdr,
#     franken-agent-detection and russh; running `cargo about` inside herdr/
#     as well would only repeat a subset of the same crates.
#
# Both reports are rendered with the same template and merged with duplicate
# (license, crate, version) entries collapsed.
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then FAIL_FLAG=--fail; else FAIL_FLAG=""; fi
if [ -z "${ALLOW_MISSING_LICENSES-}" ]; then WRAPPER=fail_on_stderr; else WRAPPER=""; fi

ROOT_REPORT="$(mktemp)"
DAEMON_REPORT="$(mktemp)"
trap 'rm -f "$ROOT_REPORT" "$DAEMON_REPORT"' EXIT

echo "Generating licenses for the application workspace"
set -x
$WRAPPER cargo about generate \
    $FAIL_FLAG \
    -c "$CONFIG_FILE" \
    "$TEMPLATE_FILE" >"$ROOT_REPORT"
set +x

echo "Generating licenses for the daemon workspace (covers herdr, FAD and russh)"
set -x
(
    cd "$DAEMON_DIR"
    # cargo-about cannot classify the franken rider text, so it warns once per
    # crate even after the clarification resolves the expression. Those warnings
    # are expected; anything else on stderr still fails the run.
    STDERR_ALLOW_PATTERN="has no license file for crate" \
    $WRAPPER cargo about generate \
        $FAIL_FLAG \
        -c "$PROJECT_ROOT/$CONFIG_FILE" \
        "$PROJECT_ROOT/$TEMPLATE_FILE" >"$DAEMON_REPORT"
)
set +x

python3 script/licenses/merge-about.py "$ROOT_REPORT" "$DAEMON_REPORT" >>"$OUTPUT_FILE"

sed -i.bak 's/&quot;/"/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x27;/'\''/g' "$OUTPUT_FILE" # The ` '\'' ` thing ends the string, appends a single quote, and re-opens the string
sed -i.bak 's/&#x3D;/=/g' "$OUTPUT_FILE"
sed -i.bak 's/&#x60;/`/g' "$OUTPUT_FILE"
sed -i.bak 's/&lt;/</g' "$OUTPUT_FILE"
sed -i.bak 's/&gt;/>/g' "$OUTPUT_FILE"

rm -rf "${OUTPUT_FILE}.bak"

# Refuse to publish a report that is missing a shipped artifact.
python3 script/licenses/check-coverage.py "$OUTPUT_FILE"

echo "generate-licenses completed. See $OUTPUT_FILE"
